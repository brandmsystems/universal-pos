{
  "name": "@universalpos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@universalpos/shared": "workspace:*",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@universalpos/eslint-config": "workspace:*",
    "@universalpos/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
