# Copy this to .env. Every script a human runs reads it through
# `tsx --env-file-if-exists=.env`; the containers get their environment from
# docker-compose instead, which is why nothing here has a default in code.

# ############################################################################
# THE APPLICATION TALKS TO THE POOLER. MIGRATIONS TALK TO POSTGRES DIRECTLY.
#
# That split is not a deployment detail -- it is the reason the startup probe
# has something to check. `docker compose up` brings up Postgres on 5433 and
# PgBouncer in TRANSACTION mode on 6432, with the three roles created on first
# init, so a local stack behaves like a real one: RLS applies, the append-only
# grants apply, and the ownership probe has something to refuse.
#
# 5433 rather than the default 5432 because that port is routinely taken by
# another project's stack.
# ############################################################################

# Owner role — migrations, seeds, partition job. Never used to serve requests,
# and never through the pooler: DDL wants a session it keeps.
DATABASE_URL_OWNER=postgres://katkitchen_owner:change_me@localhost:5433/katkitchen

# Application role — both planes, THROUGH THE POOLER. Subject to RLS; no
# UPDATE/DELETE on audit tables.
DATABASE_URL_APP=postgres://katkitchen_app:change_me@localhost:6432/katkitchen

# Control-plane reporting only. Has no USAGE on schema app.
DATABASE_URL_PLATFORM_READONLY=postgres://katkitchen_platform_readonly:change_me@localhost:5433/katkitchen

# --- the API ----------------------------------------------------------------
# HS256, and there is deliberately NO default: a signing key with a fallback is
# one every deployment that forgot to set it shares. At least 32 characters.
#   openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_long_random_string_at_least_32_chars
PORT=8080

# Months of audit partitions to keep ahead of now(). The job must run as the owner role.
AUDIT_PARTITION_MONTHS_AHEAD=3

# The entitlement cache. Not durable: a restart empties it, and the boot warm-up
# is what stops that becoming a platform-wide outage.
REDIS_URL=redis://localhost:6380

# --- the pooling probe, both directions -------------------------------------
# Only needed to run tests/db/pooling.test.ts. The statement-mode pooler is
# deliberately misconfigured and is never used by the application: it exists so
# the FAILING direction of the probe is exercised, because a safety check that
# has only ever been seen to pass is one nobody has shown to work.
#   docker compose --profile probe up -d
DATABASE_URL_POOLED=postgres://katkitchen_app:change_me@localhost:6432/katkitchen
DATABASE_URL_POOLED_STATEMENT=postgres://katkitchen_app:change_me@localhost:6433/katkitchen

# --- local seed scripts (development only; never set in production) ---------
# Nothing here has a default in code. Leave these unset and `pnpm seed:demo`
# generates each secret and prints it once; set them only to choose your own.
#   DEV_SUPER_ADMIN_EMAIL=
#   DEV_SUPER_ADMIN_PASSWORD=
#   DEMO_PASSWORD=
#   DEMO_PIN=

# Keeps the Docker project (and its database volume) stable whatever the folder is called.
COMPOSE_PROJECT_NAME=upos
