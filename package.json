{
  "name": "katkitchen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/check-lockfiles.mjs",
    "postinstall": "tsc -p packages/shared/tsconfig.json",
    "typecheck": "pnpm -r typecheck",
    "build": "tsc -p packages/shared/tsconfig.json && pnpm --filter @katkitchen/api build",
    "test": "pnpm --filter @katkitchen/api test",
    "test:web": "pnpm --filter @katkitchen/web test",
    "test:pooling": "pnpm --filter @katkitchen/api exec vitest run tests/db/pooling.test.ts",
    "lint:lockfiles": "node scripts/check-lockfiles.mjs",
    "db:bootstrap": "psql -v ON_ERROR_STOP=1 -f db/bootstrap/00_roles.sql && psql -v ON_ERROR_STOP=1 -d katkitchen -f db/bootstrap/01_database.sql",
    "db:bootstrap:managed": "tsx --env-file-if-exists=.env scripts/bootstrap-managed.mts",
    "db:migrate": "tsx --env-file-if-exists=.env apps/api/src/core/database/migrate.ts up",
    "db:seed": "tsx --env-file-if-exists=.env apps/api/src/core/database/seed.ts",
    "db:rollback": "tsx --env-file-if-exists=.env apps/api/src/core/database/migrate.ts down",
    "db:status": "tsx --env-file-if-exists=.env apps/api/src/core/database/migrate.ts status",
    "db:partitions": "tsx --env-file-if-exists=.env apps/api/src/core/database/partitions.ts",
    "db:test:create": "docker compose exec -T postgres sh /bootstrap/test_database.sh",
    "db:migrate:built": "node --env-file-if-exists=.env apps/api/dist/core/database/migrate.js",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "stack:probe": "docker compose --profile probe up -d --wait pgbouncer-statement",
    "api": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "dev:web": "pnpm --filter @katkitchen/web dev",
    "build:web": "pnpm --filter @katkitchen/web build",
    "job": "tsx --env-file-if-exists=.env apps/api/src/jobs/runner.ts",
    "job:health": "tsx --env-file-if-exists=.env apps/api/src/jobs/runner.ts --health",
    "job:usage-rollup": "tsx --env-file-if-exists=.env apps/api/src/modules/metering/usageRollup.ts",
    "job:outbox-drain": "tsx --env-file-if-exists=.env apps/api/src/modules/notifications/outboxWorker.ts",
    "job:print-drain": "tsx --env-file-if-exists=.env apps/api/src/modules/kitchen/printWorker.ts",
    "probe:host": "tsx --env-file-if-exists=.env scripts/probe-host.mts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.mts",
    "postman": "tsx --env-file-if-exists=.env scripts/postman-collection.mts",
    "seed:dummy": "tsx --env-file-if-exists=.env scripts/seed-dummy.mts",
    "seed:platform-user": "tsx --env-file-if-exists=.env scripts/seed-platform-user.mts",
    "backfill:reasons": "tsx --env-file-if-exists=.env scripts/backfill-adjustment-reasons.mts",
    "backfill:tax-classes": "tsx --env-file-if-exists=.env scripts/backfill-tax-classes.mts",
    "reconcile:roles": "tsx --env-file-if-exists=.env scripts/reconcile-system-roles.mts",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "argon2": "^0.41.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
